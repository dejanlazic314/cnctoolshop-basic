<?php
    use Magmell\Contao\Basic\VHUGUtil;
    use Cnctoolshop\Classes\LanguageSwitcher;
    VHUGUtil::include_css('bundles/cnctoolshop/css/frontend/header.scss|static');
    $GLOBALS['TL_JAVASCRIPT'][] = "bundles/cnctoolshop/js/frontend/header.js|static";

    // Default to each language's homepage, then try to find the actual
    // translation counterpart of the page currently being viewed.
    $langSwitcherSrId = 3;
    $langSwitcherEnId = 5;

    if ($GLOBALS['objPage'] instanceof \Contao\PageModel) {
        $objCurrentPage = $GLOBALS['objPage'];
        $objCounterpart = LanguageSwitcher::getCounterpartPage($objCurrentPage);

        if ($objCurrentPage->language === 'sr') {
            $langSwitcherSrId = $objCurrentPage->id;
            if ($objCounterpart !== null) {
                $langSwitcherEnId = $objCounterpart->id;
            }
        } elseif ($objCurrentPage->language === 'en') {
            $langSwitcherEnId = $objCurrentPage->id;
            if ($objCounterpart !== null) {
                $langSwitcherSrId = $objCounterpart->id;
            }
        }
    }
?>

<header class="header" id="header">
    <div class="header-inner">
        <a href="/" class="header-logo" title="CNC Toolshop">
            {{file_vendor::dejanlazic314/cnctoolshop-basic/public/icons/cnctoolshop-logo.html5}}
        </a>

        <nav class="header-nav" id="main-nav" aria-label="{{iflng::sr}}Glavna navigacija{{iflng}}{{iflng::en}}Main navigation{{iflng}}">
            {{insert_module::1}}
        </nav>

        <div class="header-actions">
            <div class="header-lang-switcher">
                <a href="{{link_url::<?= $langSwitcherSrId ?>}}" class="header-lang-switcher-btn{{iflng::sr}} is-active{{iflng}}" hreflang="sr">SR</a>
                <a href="{{link_url::<?= $langSwitcherEnId ?>}}" class="header-lang-switcher-btn{{iflng::en}} is-active{{iflng}}" hreflang="en">EN</a>
            </div>
            <a href="{{iflng::sr}}{{link_url::6}}{{iflng}}{{iflng::en}}{{link_url::7}}{{iflng}}" class="header-cta">{{iflng::sr}}Zatražite ponudu{{iflng}}{{iflng::en}}Request a Quote{{iflng}}</a>
        </div>

        <button class="header-toggle" id="mobile-toggle" 
            aria-label="{{iflng::sr}}Otvori meni{{iflng}}{{iflng::en}}Open menu{{iflng}}" 
            aria-expanded="false"
            data-label-open="{{iflng::sr}}Otvori meni{{iflng}}{{iflng::en}}Open menu{{iflng}}"
            data-label-close="{{iflng::sr}}Zatvori meni{{iflng}}{{iflng::en}}Close menu{{iflng}}">
            <span></span>
            <span></span>
            <span></span>
        </button>
    </div>

    <div class="header-mobile-extras">
        <a href="{{link_url::19}}" class="header-mobile-cta">Zatražite ponudu</a>
        <div class="header-mobile-lang">
            <a href="/" class="is-active" hreflang="sr">Srpski</a>
            <a href="/en" hreflang="en">English</a>
        </div>
    </div>
</header>
